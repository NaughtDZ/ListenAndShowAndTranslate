@echo off
REM ============================================================
REM  兼容入口：转发到「启动.bat」
REM  保留它是为了兼容早期文档里写的 start.bat --list-audio 等用法。
REM  真正的逻辑只在「启动.bat」里维护一份，避免两个入口各自漂移。
REM ============================================================
chcp 65001 >nul
call "%~dp0启动.bat" %*
exit /b %errorlevel%
