# 统一换行符，避免 "LF will be replaced by CRLF" 噪音
* text=auto eol=lf

# Windows 批处理必须保持 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件不做换行转换
*.png binary
*.jpg binary
*.ico binary
*.onnx binary
*.bin binary
*.gguf binary
*.pyd binary
*.dll binary
*.exe binary

# 让 GitHub 正确识别语言
*.md linguist-documentation
